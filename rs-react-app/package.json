    "deploy": "gh-pages -d dist",
    "test": "vitest --no-watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "react": "^19.2.6",

      "npx prettier --write"
    ]
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@types/react-redux": "^7.1.34",
    "gh-pages": "^6.3.0",
    "next": "^16.2.9",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-redux": "^9.3.0",
    "react-router": "^7.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
